---
import { DOCS_URL, HELM_URL, LICENSE_URL, QUICKSTART_URL, REDDIT_URL, RELEASES_URL, REPO_URL, X_URL, docs } from "../data/site";

// Icon paths from Starlight's icon set (MIT), inlined so the landing page loads none of the docs CSS.
const X_ICON = "M 18.242188 2.25 L 21.554688 2.25 L 14.324219 10.507812 L 22.828125 21.75 L 16.171875 21.75 L 10.953125 14.933594 L 4.992188 21.75 L 1.679688 21.75 L 9.40625 12.914062 L 1.257812 2.25 L 8.082031 2.25 L 12.792969 8.480469 Z M 17.082031 19.773438 L 18.914062 19.773438 L 7.082031 4.125 L 5.113281 4.125 Z M 17.082031 19.773438";
const REDDIT_ICON = "M14.41 16.87a3.38 3.38 0 0 1-2.37.63 3.37 3.37 0 0 1-2.36-.63 1 1 0 0 0-1.42 1.41 5.11 5.11 0 0 0 3.78 1.22 5.12 5.12 0 0 0 3.78-1.22 1 1 0 1 0-1.41-1.41ZM9.2 15a1 1 0 1 0-1-1 1 1 0 0 0 1 1Zm6-2a1 1 0 1 0 1 1 1 1 0 0 0-1-1Zm7.8-1.22a3.77 3.77 0 0 0-6.8-2.26 16.5 16.5 0 0 0-3.04-.48l.85-5.7 2.09.7a3 3 0 0 0 6-.06v-.02a3.03 3.03 0 0 0-3-2.96 2.98 2.98 0 0 0-2.34 1.16l-3.24-1.1a1 1 0 0 0-1.3.8l-1.09 7.17a16.66 16.66 0 0 0-3.34.49 3.77 3.77 0 0 0-6.22 4.23A4.86 4.86 0 0 0 1 16c0 3.92 4.83 7 11 7s11-3.08 11-7a4.86 4.86 0 0 0-.57-2.25 3.78 3.78 0 0 0 .57-1.97ZM19.1 3a1 1 0 1 1-1 1 1.02 1.02 0 0 1 1-1ZM4.77 10a1.76 1.76 0 0 1 .88.25A9.98 9.98 0 0 0 3 11.92v-.14A1.78 1.78 0 0 1 4.78 10ZM12 21c-4.88 0-9-2.29-9-5s4.12-5 9-5 9 2.29 9 5-4.12 5-9 5Zm8.99-9.08a9.98 9.98 0 0 0-2.65-1.67 1.76 1.76 0 0 1 .88-.25A1.78 1.78 0 0 1 21 11.78l-.01.14Z";

const columns = [
  {
    title: "Product",
    links: [
      { href: "#how", label: "How it works" },
      { href: "#pools", label: "Pools" },
      { href: "#compat", label: "OpenAI-compatible" },
      { href: "#features", label: "Features" },
      { href: "#dashboard", label: "Dashboard" },
      { href: "#faq", label: "FAQ" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: QUICKSTART_URL, label: "Quick start" },
      { href: docs("/clients/codex-cli-desktop/"), label: "Codex CLI setup" },
      { href: docs("/clients/openai-compatible/"), label: "OpenAI-compatible tools" },
      { href: docs("/deployment/docker-compose/"), label: "Deployment" },
      { href: DOCS_URL, label: "All docs" },
    ],
  },
  {
    title: "Guides",
    links: [
      { href: docs("/discovery/self-hosted-codex-gateway/"), label: "Self-hosted Codex gateway" },
      { href: docs("/discovery/codex-account-pooling/"), label: "Codex account pooling" },
      { href: docs("/discovery/openai-compatible-codex-gateway/"), label: "OpenAI-compatible Codex gateway" },
      { href: docs("/discovery/ai-coding-agent-gateway/"), label: "AI coding agent gateway" },
      { href: docs("/discovery/codex-pooler-vs-direct-credentials/"), label: "Pool keys vs direct credentials" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: REPO_URL, label: "GitHub" },
      { href: RELEASES_URL, label: "Releases" },
      { href: HELM_URL, label: "Helm chart" },
      { href: LICENSE_URL, label: "License" },
    ],
  },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a class="brand" href="/" aria-label="Codex Pooler home">
          <img src="/icon.svg" width="36" height="36" alt="" />
          <span>Codex Pooler</span>
        </a>
        <p>The self-hosted gateway for your Codex accounts, pooled your way.</p>
        <ul class="social">
          <li>
            <a href={X_URL}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={X_ICON} /></svg><span>@icoretech_inc</span></a>
          </li>
          <li>
            <a href={REDDIT_URL}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={REDDIT_ICON} /></svg><span>r/CodexPooler</span></a>
          </li>
        </ul>
      </div>
      {
        columns.map((column) => (
          <nav class="foot-col" aria-label={column.title}>
            <p class="foot-title">{column.title}</p>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="foot-bottom">
      <p>© {new Date().getFullYear()} iCoreTech · Source available under the Elastic License 2.0</p>
      <p>OpenAI and Codex are trademarks of OpenAI. All other product names, logos and brands shown on this site belong to their respective owners and appear only to show which tools Codex Pooler works with. Codex Pooler is an independent project, not affiliated with, sponsored or endorsed by OpenAI or by the makers of any tool shown here.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 64px 36px;
    background: var(--night);
    color: var(--night-ink-2);
  }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr));
    gap: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--night-line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-size: 21px;
    font-weight: 850;
    text-transform: uppercase;
    color: var(--orange);
  }

  .foot-brand p {
    max-width: 22em;
    margin-top: 14px;
    font-size: 16px;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block: -8px;
    padding-block: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--night-ink);
    transition: color 0.15s;
  }

  .social a:hover {
    color: var(--orange-2);
  }

  .social svg {
    width: 17px;
    height: 17px;
    flex: none;
  }

  .foot-col {
    display: grid;
    align-content: start;
    gap: 10px;
    font-size: 16px;
  }

  .foot-title {
    margin-bottom: 4px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--night-ink-3);
  }

  .foot-col a {
    color: var(--night-ink);
    transition: color 0.15s;
  }

  .foot-col a:hover {
    color: var(--orange-2);
  }

  .foot-bottom {
    display: grid;
    gap: 8px;
    padding-top: 26px;
    font-size: 13.5px;
    color: var(--night-ink-3);
  }

  @media (max-width: 980px) {
    .foot-top {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .foot-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 680px) {
    .foot-top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
