</style>

<script>
  // A request log that keeps receiving requests from a mix of clients.
  const body = document.querySelector<HTMLElement>("[data-live-log]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (body && !reduceMotion) {
    const clients = [
      { logo: "codex", ua: "codex_cli_rs 0.160.0" },
      { logo: "codex", ua: "Codex Desktop 1.4.2" },
      { logo: "opencode", ua: "opencode 2.0.0" },
      { logo: "python", ua: "OpenAI/Python 2.8.1" },
      { logo: "nodedotjs", ua: "OpenAI/JS 6.3.0" },
      { logo: "vercel", ua: "ai-sdk/openai 3.0.12" },
      { logo: "goose", ua: "goose 1.12.0" },
      { logo: "hermesagent", ua: "hermes-cli 1.0.0" },
      { logo: "omp", ua: "omp 1.0.0" },
      { logo: "aider", ua: "aider 0.86.1" },
      { logo: "cline", ua: "Cline 3.36.0" },
      { logo: "continue", ua: "Continue 1.2.9" },
      { logo: "kilocode", ua: "Kilo-Code 4.98.0" },
      { logo: "openhands", ua: "openhands 0.59.0" },
    ];
    const accounts = ["Account A", "Account B", "Account C", "Account D", "Account E"];
    const models = ["gpt-6-luna", "gpt-6-luna", "gpt-6-sol", "gpt-6-astra"];
    const kpi = (name: string) => document.querySelector<HTMLElement>(`[data-kpi="${name}"]`);
    const shown = { requests: kpi("requests"), tokens: kpi("tokens"), cost: kpi("cost") };
    let requests = 1572;
    let tokens = 41.2e6;
    let cost = 58.4;
    let last = -1;
    let timer = 0;
    const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];

    const addRow = () => {
      let index = Math.floor(Math.random() * clients.length);
      if (index === last) index = (index + 1) % clients.length;
      last = index;
      const client = clients[index];
      const rowTokens = 18_000 + Math.round(Math.random() * 70_000);
      const rowCost = rowTokens * (0.00000085 + Math.random() * 0.0000004);

      const row = document.createElement("div");
      row.className = "log-row enter";
      [client.ua, pick(accounts), pick(models), `${(rowTokens / 1000).toFixed(1)}k`, `$${rowCost.toFixed(2)}`].forEach((text, i) => {
        const cell = document.createElement("span");
        if (i === 0) {
          const logo = document.createElement("i");
          logo.className = "logo";
          logo.style.setProperty("--src", `url(/logos/${client.logo}.svg)`);
          cell.append(logo);
          // The version sits in its own span so narrow screens can drop it.
          const cut = text.lastIndexOf(" ");
          const version = document.createElement("span");
          version.className = "ver";
          version.textContent = text.slice(cut);
          cell.append(text.slice(0, cut), version);
        } else {
          cell.append(text);
        }
        row.append(cell);
      });
      body.prepend(row);
      while (body.children.length > 5) body.lastElementChild?.remove();

      requests += 1;
      tokens += rowTokens;
      cost += rowCost;
      if (shown.requests) shown.requests.textContent = requests.toLocaleString("en-US");
      if (shown.tokens) shown.tokens.textContent = `${(tokens / 1e6).toFixed(1)}M`;
      if (shown.cost) shown.cost.textContent = `$${cost.toFixed(2)}`;
    };

    const tick = () => {
      addRow();
      timer = window.setTimeout(tick, 900 + Math.random() * 900);
    };

    new IntersectionObserver(([entry]) => {
      window.clearTimeout(timer);
      if (entry.isIntersecting) timer = window.setTimeout(tick, 500);
    }).observe(body);
  }
</script>
